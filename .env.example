# Copy to `.env` in the repo root for local development and fill in values.
# `.env` is git-ignored. For production, set the same names in
# Vercel → Project → Settings → Environment Variables (scope: Production).
# Never paste real values into chat, code, or commits.

# --- Clerk (authentication) — Clerk dashboard → API keys ---
# Use the production instance (pk_live_/sk_live_) for Production on Vercel, and
# the development instance (pk_test_/sk_test_) locally and for Preview deploys.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Same value as CLERK_PUBLISHABLE_KEY. The VITE_ prefix exposes it to the browser
# build (publishable keys are designed to be public; the secret key is not).
VITE_CLERK_PUBLISHABLE_KEY=
# Optional: only if you enable Clerk's proxy mode (leave empty normally).
VITE_CLERK_PROXY_URL=

# --- Groq (AI evaluation) — console.groq.com → API Keys ---
# ONE key from ONE Groq account. Using several accounts to exceed limits is
# against Groq's Acceptable Use Policy and risks suspension of all of them.
GROQ_API_KEY=
# Optional: models tried in order (comma-separated). Each model has its own
# rate limit inside your account. Default: openai/gpt-oss-120b,llama-3.3-70b-versatile
GROQ_MODELS=

# --- Database (Postgres) — use the provider's POOLED connection string ---
DATABASE_URL=

# --- Optional tuning ---
# IANA time zone used for the daily practice streak (e.g. Asia/Kolkata).
APP_TIMEZONE=UTC
# Max evaluations per signed-in user per rolling 24h (protects the shared Groq quota).
EVALUATIONS_PER_USER_PER_DAY=40
