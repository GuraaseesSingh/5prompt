{
  "buildCommand": "node scripts/build-vercel-api.mjs",
  "installCommand": "pnpm install --frozen-lockfile",
  "outputDirectory": "artifacts/prompt-arena/dist/public",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api"
    },
    {
      "source": "/((?!api(?:/|$)).*)",
      "destination": "/index.html"
    }
  ]
}